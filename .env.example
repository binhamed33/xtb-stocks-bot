# ================= Discord =================
# Scheduled posts (open/close, pre-market brief) go through a channel webhook:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Slash commands (/analyze, /sharia, /portfolio ...) need a bot application:
#   https://discord.com/developers/applications -> New Application -> Bot -> Reset Token
#   OAuth2 -> URL Generator -> scopes: bot, applications.commands -> permissions: Send Messages, Embed Links, Attach Files
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=                 # your server id (right-click server -> Copy Server ID); makes commands appear instantly
DISCORD_CHANNEL_ID=               # channel id for alerts that cannot be DM'd
ADMIN_USER_IDS=                   # comma-separated Discord user ids allowed to verify XTB instruments and view /status

# ================= AI (Google Gemini only) =================
# https://aistudio.google.com/apikey  -> Create API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DAILY_CALL_LIMIT=200

# ================= Data providers (Yahoo Finance + SEC EDGAR are free and need no key) =================
SEC_USER_AGENT="xtb-stocks-bot your-email@example.com"   # SEC requires a contact in the User-Agent
# FINNHUB_API_KEY=                 # https://finnhub.io  (free tier: company news, basic financials)
# FMP_API_KEY=                     # https://site.financialmodelingprep.com/developer/docs (free tier: profile, ratios)
# ALPHAVANTAGE_API_KEY=            # reserved

# ================= Sharia =================
SHARIA_METHOD=AAOIFI              # AAOIFI | MSCI | FTSE (never mixed)
HALAL_ONLY=true                   # only HALAL names are presented as investable
SHARIA_RESCREEN_DAYS=30           # re-screen automatically after this many days
# HALAL_WHITELIST=AAPL,MSFT       # names you verified with a certified screener (Zoya/Musaffa)
# HALAL_BLACKLIST=TSLA

# ================= XTB real-stock verification =================
# XTB has no public API. Confirm names with /xtb verify, or import a CSV with /xtb import.
XTB_TRUST_HEURISTIC=false         # true = accept 'equity on an exchange XTB serves' as REAL_STOCK (labelled heuristic)

# ================= Watch-list & schedule =================
# STOCK_UNIVERSE=AAPL,MSFT,...     # daily brief universe (max 80)
# SCAN_UNIVERSE=...                # /scan universe (default ~110 halal-friendly US names)
# HOLDINGS=AAPL:10@180.5,MSFT:5@400   # legacy: holdings for the scheduled brief (slash /portfolio is the real manager)
PORTFOLIO_SIZE=10000
RISK_PER_TRADE_PCT=1.0
USER_TZ=Asia/Muscat
PREMARKET_MINUTES_BEFORE_OPEN=45
SEND_MIDDAY_UPDATE=true
MIDDAY_HOUR_ET=12
MORNING_HOUR_LOCAL=9
MAX_BUY_PICKS=5
MAX_SELL_PICKS=5
MAX_AVOID_PICKS=5
LANGUAGE=ar

# ================= Alerts =================
ALERT_DROP_PCT=5                  # auto alert when a portfolio/watchlist name drops this much in a day
ALERT_CHECK_MINUTES=30

# ================= Storage =================
BOT_STATE_DIR=./state
# DB_PATH=./state/stockbot.sqlite3
# BOT_LOG_FILE=./bot.log
