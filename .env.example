# ---- required ----
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
ANTHROPIC_API_KEY=sk-ant-...

# ---- halal ----
HALAL_ONLY=true                          # recommend only stocks that pass the AAOIFI screen
# HALAL_WHITELIST=AAPL,MSFT              # force-allow (e.g. certified by Zoya/Musaffa)
# HALAL_BLACKLIST=TSLA                   # force-exclude
MORNING_HOUR_LOCAL=9                     # "market opens in X hours" note, your local time

# ---- what to watch ----
# STOCK_UNIVERSE=AAPL,MSFT,NVDA,...     # default: 40 large US names available on XTB
# HOLDINGS=AAPL:10@180.5,MSFT:5@400     # your positions: TICKER:qty@avg_price -> hold/sell advice
PORTFOLIO_SIZE=10000                     # USD, used to size the suggested share count
RISK_PER_TRADE_PCT=1.0

# ---- schedule ----
USER_TZ=Asia/Muscat
PREMARKET_MINUTES_BEFORE_OPEN=45
SEND_MIDDAY_UPDATE=true
MIDDAY_HOUR_ET=12

# ---- picks ----
MAX_BUY_PICKS=5
MAX_SELL_PICKS=5
MAX_AVOID_PICKS=5
LANGUAGE=ar

# ---- Claude ----
ANTHROPIC_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# ---- files ----
BOT_STATE_DIR=./state
# BOT_LOG_FILE=./bot.log
